    "test:android:stress": "node scripts/release/stress_android74.js",
    "test:android:ui": "playwright test -c playwright.android74.config.js",
    "test:knowledge:stress": "node scripts/release/stress_v75.js",
    "test:database:stress": "node scripts/release/stress_v76.js",
    "test:universal": "node --test packages/editor-ui/tests/geometric-balance-v8.test.js packages/editor-ui/tests/home-session-state.test.js packages/editor-ui/tests/home-templates-recent.test.js packages/editor-ui/tests/state-undo-layout-regression.test.js packages/editor-ui/tests/linked-views-dom.test.js packages/editor-ui/tests/view-workspace-persistence.test.js packages/editor-ui/tests/clockwise-balance-finalization.test.js packages/editor-ui/tests/continuation-hud-controls.test.js packages/map-core/tests/adaptive-continuation.test.js packages/map-core/tests/continuation.test.js",
    "test:universal:browser": "playwright test tests/browser/universal-workspace.spec.js",
    "dev:website": "node scripts/dev/serve-website.cjs",
